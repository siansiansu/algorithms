---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/custom.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "LeetCode 刷題筆記", image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Bîn-hiân ê 演算法練習</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/img/favicon.ico" />
    <link rel="preload" href="/fonts/jf-openhuninn-2.1.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="keywords" content="LeetCode, algorithms, 演算法, 刷題, 程式設計" />
    <!-- KaTeX for math -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <!-- Algolia DocSearch -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@docsearch/css@3" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@docsearch/js@3"></script>
    <script is:inline>
      if (typeof docsearch !== 'undefined') {
        docsearch({
          appId: 'GBJAF15HLX',
          apiKey: '58ce02e5ed689de64dcf99dfea57f03b',
          indexName: 'Algorithm Website',
          container: '#docsearch',
        });
      }
    </script>
  </body>
</html>
